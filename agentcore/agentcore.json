{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "GrantHound",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "GrantHound"
  },
  "runtimes": [
    {
      "name": "GrantHound",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "agent/",
      "runtimeVersion": "PYTHON_3_14",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "lifecycleConfiguration": {
        "idleRuntimeSessionTimeout": 3600,
        "maxLifetime": 7200
      },
      "additionalPolicies": [
        "policies/store-access.json"
      ]
    }
  ],
  "memories": [],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "payments": []
}
