# Copy to .env and fill in the two names from infra/outputs.json after
# `cdk deploy GranthoundStore`. The scripts under scripts/ read this file;
# the deployed runtime reads agent/runtime.env instead. Nothing here is a
# secret: the Telegram bot token lives only in SSM Parameter Store.
GRANTHOUND_TABLE=
GRANTHOUND_BUCKET=
AWS_REGION=us-east-1

# Optional: Telegram cycle summary. Name of an SSM SecureString holding
# "<bot token>|<chat id>", and the public inbox URL linked from the message.
# GRANTHOUND_TELEGRAM_PARAM=/granthound/telegram
# GRANTHOUND_SITE_URL=https://example.cloudfront.net
